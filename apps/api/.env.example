DATABASE_URL=postgres://eventmaster:eventmaster@localhost:5432/eventmaster
DATABASE_URL_TEST=postgres://eventmaster:eventmaster@localhost:5432/eventmaster_test
PORT=3000
# Gere um valor próprio: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Segredo que assina os webhooks do gateway de pagamento (gere outro valor, do mesmo jeito).
WEBHOOK_SECRET=
# Origem do front-end autorizada a fazer requisições de escrita.
WEB_ORIGIN=http://localhost:5173
# Worker: envio de e-mails (Mailpit em desenvolvimento, interface em http://localhost:8025).
SMTP_URL=smtp://localhost:1025
MAIL_FROM=EventMaster <nao-responda@eventmaster.local>
