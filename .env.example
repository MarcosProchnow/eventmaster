# Variáveis do `docker compose --profile app` (aplicação completa em contêineres).
# Copie para `.env` (fora do Git) e gere os segredos:
#   openssl rand -base64 48
JWT_SECRET=
WEBHOOK_SECRET=

# Origem pública do front. Precisa ser a URL que o navegador usa.
WEB_ORIGIN=http://localhost:8080

# Descomente junto com `--profile observabilidade` para enviar traces ao Jaeger.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318

# Só para o teste de carga (infra/carga/reserva.ts): um único usuário faz milhares de reservas,
# então o limite de reservas ativas por pessoa precisa subir. Em uso normal, deixe vazio (padrão: 3).
# MAX_ACTIVE_RESERVATIONS=100000
# AUTH_RATE_LIMIT_MAX=100000   # o teste cadastra um usuário por requisição concorrente
